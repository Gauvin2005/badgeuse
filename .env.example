# Codes d'authentification (6–8 caractères recommandés)
CODE_EMPLOYE=employe
CODE_PATRON=patron

# Base de données (chemin vers le fichier SQLite)
DATABASE_URL=./badgeuse.db

# SMTP (notification au patron à chaque nouvelle absence)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=badgeuse@example.com

# Email du patron (destinataire des notifications d'absence)
MAIL_PATRON=patron@example.com

# URL du site (pour les liens dans les mails)
SITE_URL=https://badgeuse.example.com
